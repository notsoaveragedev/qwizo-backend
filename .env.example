# development | production (production hides /docs, /redoc and /openapi.json)
ENV=development
# Where `python3 main.py` listens (optional). Use HOST=0.0.0.0 inside Docker or on a server.
HOST=127.0.0.1
PORT=8000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Frontend addresses allowed to call this API from a browser (exact match, no trailing slash)
CORS_ORIGINS=["http://localhost:3000"]
# MongoDB Atlas: Database → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_NAME=qwizo
